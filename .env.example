ANTHROPIC_API_KEY=
MPE_BASE_URL=http://localhost:8181
MCP_DOCS_PATH=./docs-corpus
PORT=3001
CORS_ORIGIN=http://localhost:5173

# --- Optional: Supabase auth ---
# Leave all of these unset to run with no login, same as today (RoleSwitcher
# only). Set them to require sign-in before the agent can be used — meant
# for a hosted deployment, not local dev. Run `npx supabase start` first to
# get local values for the first three; SUPABASE_SERVICE_ROLE_KEY and
# VITE_SUPABASE_ANON_KEY are printed in its output as SECRET_KEY/SERVICE_ROLE_KEY
# and PUBLISHABLE_KEY/ANON_KEY respectively.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AGENT_DAILY_QUOTA=20
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
